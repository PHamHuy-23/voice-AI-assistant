# Byte-compiled / optimized / C-extensions
__pycache__/
*.py[cod]
*$py.class

# PyTorch checkpoints and models
*.pt
*.pth
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/tcresnet8_clean_weights.pt

# Datasets and large raw audio files
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
*.wav
!demo/assets/sounds/*.wav
*.mp3
*.flac
*.tar.gz
*.zip

# Temporary exports (curated report artifacts remain versioned)
reports/tmp/
demo/codex_runs/
demo/action_cache/
tests/tmp*/

# Environments & OS specific
.venv/
venv/
env/
ENV/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

# AI Development OS Memory Bank
.ai/

# Backup files
*.bak
